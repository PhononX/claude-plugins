<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{JOB_LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{WORKSPACE}}/nightly.sh</string>
  </array>
  <key>WorkingDirectory</key><string>{{WORKSPACE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{PATH}}</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>StandardOutPath</key><string>{{WORKSPACE}}/cos/log/launchd.out.log</string>
  <key>StandardErrorPath</key><string>{{WORKSPACE}}/cos/log/launchd.err.log</string>
</dict>
</plist>
